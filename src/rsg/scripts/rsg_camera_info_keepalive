#!/usr/bin/env python3
"""Repeatedly republish a bag's single CameraInfo message on its own topic.

The OpenLoRIS bag records exactly one CameraInfo message on
/d400/color/camera_info, published once near the start of the bag. Even with
a TRANSIENT_LOCAL QoS override on `ros2 bag play` (see
rsg_pipeline_openloris_qos_overrides.yaml), a single busy subscriber -- the
RSG preprocessor, servicing RGB/depth at ~30 Hz -- can go an entire bag replay
without ever getting a scheduling turn for that one-shot delivery (observed:
809/809 frames rejected with "camera_info_unavailable" despite the QoS fix).

This node removes the single-point-of-failure: it subscribes once (with
nothing else competing for its executor), caches the message, and republishes
it on the SAME topic every republish_period_sec. Any subscriber gets many
chances across a run instead of exactly one.
"""
from __future__ import annotations

import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import CameraInfo


class CameraInfoKeepAlive(Node):
    def __init__(self) -> None:
        super().__init__("rsg_camera_info_keepalive")

        self.declare_parameter("topic", "/d400/color/camera_info")
        self.declare_parameter("republish_period_sec", 0.5)

        topic = self.get_parameter("topic").get_parameter_value().string_value
        period = self.get_parameter("republish_period_sec").get_parameter_value().double_value
        if period <= 0.0:
            raise ValueError("republish_period_sec must be > 0")

        qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )

        self.latest: CameraInfo | None = None
        self.received_count = 0
        self.republished_count = 0

        self.sub = self.create_subscription(CameraInfo, topic, self._on_camera_info, qos)
        self.pub = self.create_publisher(CameraInfo, topic, qos)
        self.timer = self.create_timer(period, self._republish)
        self.watchdog = self.create_timer(5.0, self._watchdog)

        self.get_logger().info(f"Keeping {topic} alive, republishing every {period}s once received")

    def _on_camera_info(self, msg: CameraInfo) -> None:
        first = self.latest is None
        self.latest = msg
        self.received_count += 1
        if first:
            self.get_logger().info(
                f"Received CameraInfo ({msg.width}x{msg.height}, frame_id={msg.header.frame_id!r}); "
                "starting keep-alive republish"
            )

    def _republish(self) -> None:
        if self.latest is not None:
            self.pub.publish(self.latest)
            self.republished_count += 1

    def _watchdog(self) -> None:
        if self.latest is None:
            self.get_logger().warning("No CameraInfo received yet; confirm the bag is playing")


def main(args: list[str] | None = None) -> None:
    rclpy.init(args=args)
    node = CameraInfoKeepAlive()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
