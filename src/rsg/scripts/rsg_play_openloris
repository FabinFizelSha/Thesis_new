#!/usr/bin/env bash
set -euo pipefail

bag_path="${RSG_OPENLORIS_BAG:-/home/student/datasets/openloris/office/office1-1_7-rosbag/office1-2_ros2}"

if [[ ! -f "${bag_path}/metadata.yaml" ]]; then
  echo "ROS 2 bag is not ready at: ${bag_path}" >&2
  echo "Set RSG_OPENLORIS_BAG to override the bag path." >&2
  exit 1
fi

# The bag recorded no QoS profile for /tf_static and /d400/color/camera_info,
# so a plain replay republishes them as RELIABLE/VOLATILE. Both carry only a
# single latched-style message at the very start of the bag, so any
# subscriber (tf2 listeners, the Hydra ROS input) that connects even slightly
# late misses it forever. Override both to TRANSIENT_LOCAL so late joiners
# still get them. See rsg_pipeline_openloris_qos_overrides.yaml for detail.
# Set RSG_OPENLORIS_QOS_OVERRIDES="" to disable.
# Resolved via `ros2 pkg prefix` rather than a path relative to this script,
# because this script installs to lib/rsg/ (ros2 run) while config/ installs
# to share/rsg/ -- a fixed relative offset between them is fragile.
rsg_prefix="$(ros2 pkg prefix rsg)"
default_qos_overrides="${rsg_prefix}/share/rsg/config/rsg_pipeline_openloris_qos_overrides.yaml"
qos_overrides="${RSG_OPENLORIS_QOS_OVERRIDES-${default_qos_overrides}}"

qos_args=()
if [[ -n "${qos_overrides}" ]]; then
  if [[ ! -f "${qos_overrides}" ]]; then
    echo "QoS overrides file not found at: ${qos_overrides}" >&2
    echo "Set RSG_OPENLORIS_QOS_OVERRIDES to the correct path, or to \"\" to disable." >&2
    exit 1
  fi
  qos_args=(--qos-profile-overrides-path "${qos_overrides}")
fi

# The QoS override above is necessary but, empirically, not sufficient: a
# busy subscriber (the RSG preprocessor, servicing RGB/depth at ~30 Hz) can
# go an entire replay without ever getting a scheduling turn for the bag's
# single one-shot CameraInfo delivery (observed 0/809 frames receiving it
# even with TRANSIENT_LOCAL). rsg_camera_info_keepalive removes the
# single-point-of-failure by repeatedly republishing the cached message for
# the duration of playback. Set RSG_OPENLORIS_CAMERA_INFO_KEEPALIVE=0 to
# disable.
keepalive_pid=""
if [[ "${RSG_OPENLORIS_CAMERA_INFO_KEEPALIVE:-1}" != "0" ]]; then
  ros2 run rsg rsg_camera_info_keepalive --ros-args -p topic:=/d400/color/camera_info &
  keepalive_pid=$!
  trap '[[ -n "${keepalive_pid}" ]] && kill "${keepalive_pid}" 2>/dev/null || true' EXIT
  sleep 1
fi

ros2 bag play "${bag_path}" --clock "${qos_args[@]}" "$@"
