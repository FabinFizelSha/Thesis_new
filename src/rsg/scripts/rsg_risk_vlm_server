#!/usr/bin/env python3
"""Start the local Risk VLM server for the RSG stack.

Unlike rsg_vlm_server (the object-detection VLM launcher), phase1.risk_vlm
has no profile-switching system -- it's one flat config block, since it's
deliberately a separate model/server from phase1.vlm with nothing to select
between. This script just reads phase1.risk_vlm.server directly and execs
llama.cpp, exactly like rsg_vlm_server does for the object-detection model.
"""

from __future__ import annotations

import argparse
import os
import shlex
import sys
from pathlib import Path
from typing import Any, Dict, List

import yaml


def _read_memory_gib() -> float:
    """Return total system memory in GiB using Linux procfs."""
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                return float(line.split()[1]) / (1024.0 * 1024.0)
    except OSError:
        pass
    return 0.0


def _resolve_risk_vlm(config_path: Path) -> Dict[str, Any]:
    """Read phase1.risk_vlm directly -- no profile resolution needed."""
    raw = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
    phase1 = raw.get("phase1", {}) or {}
    risk_vlm = dict(phase1.get("risk_vlm", {}) or {})
    if not risk_vlm:
        raise ValueError("phase1.risk_vlm is not configured in this YAML.")
    return risk_vlm


def _require_existing_file(value: str, name: str) -> str:
    """Return an expanded local file path or raise a precise configuration error."""
    path = Path(value).expanduser().resolve()
    if not path.is_file():
        raise FileNotFoundError(f"Configured {name} was not found: {path}")
    return str(path)


def _build_llama_command(server: Dict[str, Any]) -> List[str]:
    """Create the llama.cpp command for the configured Risk VLM GGUF model."""
    binary = _require_existing_file(str(server.get("binary", "")).strip(), "llama.cpp binary")
    model_path = str(server.get("model_path", "")).strip()
    mmproj_path = str(server.get("mmproj_path", "")).strip()
    hf_model = str(server.get("hf_model", "")).strip()

    command = [binary]
    if model_path:
        if not mmproj_path:
            raise ValueError("server.mmproj_path is required when server.model_path selects a local VLM GGUF file.")
        command.extend([
            "-m", _require_existing_file(model_path, "Risk VLM model file"),
            "--mmproj", _require_existing_file(mmproj_path, "Risk VLM vision projector"),
        ])
    else:
        if not hf_model:
            raise ValueError("llama_cpp requires server.hf_model or server.model_path plus server.mmproj_path.")
        command.extend(["-hf", hf_model])

    command.extend([
        "--host", str(server.get("host", "0.0.0.0")),
        "--port", str(int(server.get("port", 8100))),
        "-ngl", str(int(server.get("gpu_layers", 99))),
        "-c", str(int(server.get("context_size", 4096))),
    ])

    # Optional extra llama.cpp flags (e.g. "--reasoning off" for Qwen3.5
    # thinking models, which otherwise spend the whole token budget in
    # <think> -- see phase1.vlm's own profiles for the same flag).
    extra = server.get("extra_args") or []
    if isinstance(extra, str):
        extra = shlex.split(extra)
    command.extend(str(arg) for arg in extra)
    return command


def main() -> int:
    """Resolve phase1.risk_vlm.server, validate resources, and exec llama.cpp."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True, help="Path to rsg_pipeline.yaml")
    parser.add_argument("--dry-run", action="store_true", help="Print the resolved command without starting llama.cpp.")
    args = parser.parse_args()

    config_path = Path(args.config).expanduser().resolve()
    if not config_path.is_file():
        parser.error(f"Configuration file not found: {config_path}")

    try:
        risk_vlm = _resolve_risk_vlm(config_path)
        server = dict(risk_vlm.get("server", {}) or {})
        provider = str(server.get("provider", "")).strip().lower()
        if provider != "llama_cpp":
            raise ValueError(f"Unsupported Risk VLM server provider: {provider or 'missing'}")

        minimum_memory = float(server.get("min_system_memory_gib", 0) or 0)
        installed_memory = _read_memory_gib()
        if minimum_memory > 0 and installed_memory < minimum_memory:
            raise RuntimeError(
                f"Risk VLM server requires at least {minimum_memory:.0f} GiB "
                f"system memory, but this host reports {installed_memory:.1f} GiB."
            )

        command = _build_llama_command(server)
        print(
            f"RSG Risk VLM model={risk_vlm.get('model', '')}, "
            f"endpoint={risk_vlm.get('endpoint', '')}",
            flush=True,
        )
        print(f"RSG Risk VLM command: {shlex.join(command)}", flush=True)
        if args.dry_run:
            return 0

        os.execv(command[0], command)
    except Exception as exc:
        print(f"RSG Risk VLM server configuration error: {exc}", file=sys.stderr, flush=True)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
