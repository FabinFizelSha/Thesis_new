# --- colcon build artifacts -------------------------------------------------
# Per-package build/ and install/ trees are generated; only the top-level
# colcon stubs are tracked (kept via the negations below).
/build/*
!/build/.built_by
!/build/COLCON_IGNORE
/install/*
!/install/COLCON_IGNORE
!/install/.colcon_install_layout
!/install/local_setup.bash
!/install/local_setup.ps1
!/install/local_setup.sh
!/install/local_setup.zsh
!/install/setup.bash
!/install/setup.ps1
!/install/setup.sh
!/install/setup.zsh
!/install/_local_setup_util_ps1.py
!/install/_local_setup_util_sh.py
/log/*
!/log/COLCON_IGNORE
!/log/latest
!/log/latest_build

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- editors / OS --------------------------------------------------------
# (.idea/ is already tracked in this repo, so it is intentionally not ignored)
*.swp
.DS_Store
.~lock.*#

# --- VLM prompt-optimisation run outputs --------------------------------
# Keep the per-run scaffold (crops/.gitkeep + placeholder vlm_results.csv);
# ignore the session_<timestamp>/ folders that each pipeline run writes.
debug/prompt_optimisation_experiment/runs/*/session_*/

# --- Fuser object-relation experiment run outputs -----------------------
# Keep the results/ scaffold (.gitkeep); ignore each run's raw JSONL log
# and derived CSVs -- large, regeneratable by re-running with
# object_contact_diagnostics_enabled: true, no long-term value in git.
debug/fuser_object_relation_experiment/results/run_*/

# --- Risk VLM diagnostics run outputs ------------------------------------
# Keep DESIGN.md; ignore each run's crops + CSV -- regeneratable by
# re-running with phase1.diagnostics.enabled + phase1.risk_vlm.enabled true.
debug/risk_assessment_feature/session_*/

# --- RAP accuracy diagnostics run outputs ---------------------------------
# Crops + per-hit CSV for manual RAP accuracy verification; regeneratable by
# re-running with phase1.diagnostics.enabled + phase1.rap.enabled true.
debug/rap_accuracy_test/session_*/

# --- Object tracking experiment Part 2 run outputs ------------------------
# Keep EXPERIMENT_REPORT.md; ignore each run's periodic crops/CSV and the
# tracking_quality associations/frames/lifecycles JSONL+JSON -- large,
# regeneratable by re-running with phase1.diagnostics.enabled true.
debug/object_tracking_experiment_part2/periodic_crop_diagnostics/session_*/
debug/object_tracking_experiment_part2/tracking_quality/*

# --- Cross-run memory ------------------------------------------------------
# memory/ holds everything that survives a run: the RAP Chroma store, its
# audit log, and the phase-1 tracker state used to exercise revisit
# association. All are large, machine-local data stores rather than source.
# The README is kept so the folder's purpose is documented in git.
memory/*
!memory/README.md
